{
  "parseArgs": [
    {
      "description": "no arguments uses the defaults",
      "argv": [],
      "expected": { "to": "e164", "country": "1", "count": false, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--to national is accepted",
      "argv": ["--to", "national"],
      "expected": { "to": "national", "country": "1", "count": false, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--country overrides the default",
      "argv": ["--country", "44"],
      "expected": { "to": "e164", "country": "44", "count": false, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--to and --country combine",
      "argv": ["--to", "national", "--country", "44"],
      "expected": { "to": "national", "country": "44", "count": false, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--count sets the count flag",
      "argv": ["--count"],
      "expected": { "to": "e164", "country": "1", "count": true, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--count combines with --to and --country",
      "argv": ["--to", "national", "--country", "44", "--count"],
      "expected": { "to": "national", "country": "44", "count": true, "strip": false, "wrapLookahead": 1 }
    },
    {
      "description": "--strip sets the strip flag",
      "argv": ["--strip"],
      "expected": { "to": "e164", "country": "1", "count": false, "strip": true, "wrapLookahead": 1 }
    },
    {
      "description": "--strip combines with --to and --country",
      "argv": ["--to", "national", "--country", "44", "--strip"],
      "expected": { "to": "national", "country": "44", "count": false, "strip": true, "wrapLookahead": 1 }
    },
    {
      "description": "--count and --strip together throws",
      "argv": ["--count", "--strip"],
      "throws": true
    },
    {
      "description": "--wrap-lookahead overrides the default",
      "argv": ["--wrap-lookahead", "3"],
      "expected": { "to": "e164", "country": "1", "count": false, "strip": false, "wrapLookahead": 3 }
    },
    {
      "description": "--wrap-lookahead of zero throws",
      "argv": ["--wrap-lookahead", "0"],
      "throws": true
    },
    {
      "description": "non-numeric --wrap-lookahead throws",
      "argv": ["--wrap-lookahead", "abc"],
      "throws": true
    },
    {
      "description": "--wrap-lookahead with no value throws",
      "argv": ["--wrap-lookahead"],
      "throws": true
    },
    {
      "description": "--help returns null instead of options",
      "argv": ["--help"],
      "expected": null
    },
    {
      "description": "-h is the same as --help",
      "argv": ["-h"],
      "expected": null
    },
    {
      "description": "invalid --to value throws",
      "argv": ["--to", "banana"],
      "throws": true
    },
    {
      "description": "non-numeric --country throws",
      "argv": ["--country", "abc"],
      "throws": true
    },
    {
      "description": "--country with no value throws",
      "argv": ["--country"],
      "throws": true
    },
    {
      "description": "unrecognized flag throws",
      "argv": ["--bogus"],
      "throws": true
    }
  ],
  "endToEnd": [
    {
      "description": "default options rewrite a NANP number to e164",
      "argv": [],
      "stdin": "call 212-555-4567\n",
      "expectedStdout": "call +12125554567\n"
    },
    {
      "description": "--to national rewrites to national format",
      "argv": ["--to", "national"],
      "stdin": "call 212.555.4567\n",
      "expectedStdout": "call (212) 555-4567\n"
    },
    {
      "description": "an unassigned area code is left untouched",
      "argv": [],
      "stdin": "call 555-123-4567\n",
      "expectedStdout": "call 555-123-4567\n"
    },
    {
      "description": "--country changes the assumed country for bare 10-digit numbers",
      "argv": ["--country", "44"],
      "stdin": "call 2079460958\n",
      "expectedStdout": "call +442079460958\n"
    },
    {
      "description": "multiple lines are each rewritten independently",
      "argv": [],
      "stdin": "first 212-555-2222\nsecond 415-555-4444\n",
      "expectedStdout": "first +12125552222\nsecond +14155554444\n"
    },
    {
      "description": "--help prints usage to stderr and writes nothing to stdout",
      "argv": ["--help"],
      "stdin": "",
      "expectedStdout": ""
    },
    {
      "description": "an invalid argument exits non-zero without touching stdout",
      "argv": ["--to", "bogus"],
      "stdin": "",
      "expectedStdout": "",
      "expectedExitCode": 1
    },
    {
      "description": "--count reports the total across all lines instead of rewriting",
      "argv": ["--count"],
      "stdin": "call me at 212.555.4567 or (800) 456-7890\nand +44 20 7946 0958\n",
      "expectedStdout": "3\n"
    },
    {
      "description": "--count reports zero when nothing matches",
      "argv": ["--count"],
      "stdin": "no numbers here\n",
      "expectedStdout": "0\n"
    },
    {
      "description": "a number wrapped across a line break is joined and rewritten as one",
      "argv": [],
      "stdin": "call 212-555\n4567 today\n",
      "expectedStdout": "call +12125554567 today\n"
    },
    {
      "description": "--count counts a wrapped number once, not zero or twice",
      "argv": ["--count"],
      "stdin": "call 212-555\n4567 today\n",
      "expectedStdout": "1\n"
    },
    {
      "description": "lines that don't actually wrap a number stay on separate lines",
      "argv": [],
      "stdin": "first 212-555-2222\nsecond line has no number\n",
      "expectedStdout": "first +12125552222\nsecond line has no number\n"
    },
    {
      "description": "--strip removes matched numbers instead of rewriting them",
      "argv": ["--strip"],
      "stdin": "call me at 212.555.4567 or (800) 456-7890\n",
      "expectedStdout": "call me at  or \n"
    },
    {
      "description": "--strip leaves a line with no matches untouched",
      "argv": ["--strip"],
      "stdin": "no numbers here\n",
      "expectedStdout": "no numbers here\n"
    },
    {
      "description": "--strip removes a number wrapped across a line break",
      "argv": ["--strip"],
      "stdin": "call 212-555\n4567 today\n",
      "expectedStdout": "call  today\n"
    },
    {
      "description": "--count and --strip together exits non-zero without touching stdout",
      "argv": ["--count", "--strip"],
      "stdin": "",
      "expectedStdout": "",
      "expectedExitCode": 1
    },
    {
      "description": "a number wrapped across three lines is left unjoined with the default lookahead of one",
      "argv": [],
      "stdin": "call 2125554\n5\n67 today\n",
      "expectedStdout": "call 2125554\n5\n67 today\n"
    },
    {
      "description": "--wrap-lookahead 2 joins a number wrapped across three lines",
      "argv": ["--wrap-lookahead", "2"],
      "stdin": "call 2125554\n5\n67 today\n",
      "expectedStdout": "call +12125554567 today\n"
    }
  ]
}
