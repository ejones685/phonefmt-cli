{
  "formatNumber": [
    {
      "description": "NANP number with dashes, default country, e164",
      "raw": "212-555-4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+12125554567"
    },
    {
      "description": "NANP number with parens and dash, national",
      "raw": "(212) 555-4567",
      "opts": { "to": "national", "country": "1" },
      "expected": "(212) 555-4567"
    },
    {
      "description": "NANP number with leading + and 1, e164",
      "raw": "+1 212 555 4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+12125554567"
    },
    {
      "description": "NANP number with leading + and 1, national",
      "raw": "+1 212 555 4567",
      "opts": { "to": "national", "country": "1" },
      "expected": "(212) 555-4567"
    },
    {
      "description": "known non-NANP code (UK), e164",
      "raw": "+44 20 7946 0958",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+442079460958"
    },
    {
      "description": "known non-NANP code (UK), national falls back to e164",
      "raw": "+44 20 7946 0958",
      "opts": { "to": "national", "country": "1" },
      "expected": "+442079460958"
    },
    {
      "description": "France has a fixed national grouping, e164",
      "raw": "+33 1 23 45 67 89",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+33123456789"
    },
    {
      "description": "France has a fixed national grouping, national",
      "raw": "+33123456789",
      "opts": { "to": "national", "country": "1" },
      "expected": "1 23 45 67 89"
    },
    {
      "description": "Brazil's national grouping differs for landline vs. mobile length",
      "raw": "+5511912345678",
      "opts": { "to": "national", "country": "1" },
      "expected": "11 91234 5678"
    },
    {
      "description": "Brazil landline length uses the shorter grouping",
      "raw": "+551112345678",
      "opts": { "to": "national", "country": "1" },
      "expected": "11 1234 5678"
    },
    {
      "description": "calling code not in the numbering-plan table is passed through with punctuation stripped",
      "raw": "+999 123 4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+9991234567"
    },
    {
      "description": "unknown calling code ignores --to national too",
      "raw": "+999 123 4567",
      "opts": { "to": "national", "country": "1" },
      "expected": "+9991234567"
    },
    {
      "description": "bare 10-digit number assumes the configured default country",
      "raw": "212.555.4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+12125554567"
    },
    {
      "description": "10-digit number with an area code nobody has been assigned is not a phone number",
      "raw": "555.123.4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "bare 10-digit number assumes a non-default configured country",
      "raw": "555.123.4567",
      "opts": { "to": "e164", "country": "44" },
      "expected": "+445551234567"
    },
    {
      "description": "too few digits is not a phone number",
      "raw": "12345",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "too many digits is not a phone number",
      "raw": "1234567890123456",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "7-digit local number with no country signal is not resolvable",
      "raw": "123-4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "exchange code starting with 1 is not a phone number",
      "raw": "212-155-4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "N11 exchange code is a service number, not a phone number",
      "raw": "212-911-4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "555 exchange with a line number in the fictional-use block is not a phone number",
      "raw": "212-555-0142",
      "opts": { "to": "e164", "country": "1" },
      "expected": null
    },
    {
      "description": "555 exchange with a line number outside the fictional-use block is a real number",
      "raw": "212-555-1212",
      "opts": { "to": "e164", "country": "1" },
      "expected": "+12125551212"
    }
  ],
  "reformatLine": [
    {
      "description": "two NANP numbers in one line, e164",
      "line": "call me at 212.555.4567 or (800) 456-7890",
      "opts": { "to": "e164", "country": "1" },
      "expected": "call me at +12125554567 or +18004567890"
    },
    {
      "description": "two NANP numbers in one line, national",
      "line": "call me at 212.555.4567 or (800) 456-7890",
      "opts": { "to": "national", "country": "1" },
      "expected": "call me at (212) 555-4567 or (800) 456-7890"
    },
    {
      "description": "an unassigned area code is left untouched",
      "line": "order id 555.123.4567 shipped",
      "opts": { "to": "e164", "country": "1" },
      "expected": "order id 555.123.4567 shipped"
    },
    {
      "description": "international number embedded in a sentence",
      "line": "reach the london office at +44 20 7946 0958 today",
      "opts": { "to": "e164", "country": "1" },
      "expected": "reach the london office at +442079460958 today"
    },
    {
      "description": "a country with a known national grouping is reformatted, not just passed through",
      "line": "call the paris office at +33 1 23 45 67 89 today",
      "opts": { "to": "national", "country": "1" },
      "expected": "call the paris office at 1 23 45 67 89 today"
    },
    {
      "description": "long digit run that isn't a phone number is left untouched",
      "line": "order id 1234567890123456 shipped",
      "opts": { "to": "e164", "country": "1" },
      "expected": "order id 1234567890123456 shipped"
    },
    {
      "description": "line with no digits is left untouched",
      "line": "no numbers here",
      "opts": { "to": "e164", "country": "1" },
      "expected": "no numbers here"
    }
  ],
  "countMatches": [
    {
      "description": "two NANP numbers in one line",
      "line": "call me at 212.555.4567 or (800) 456-7890",
      "opts": { "to": "e164", "country": "1" },
      "expected": 2
    },
    {
      "description": "a real number alongside a digit run that isn't one",
      "line": "order id 1234567890123456 shipped, call 212-555-4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": 1
    },
    {
      "description": "line with no digits has no matches",
      "line": "no numbers here",
      "opts": { "to": "e164", "country": "1" },
      "expected": 0
    },
    {
      "description": "an unassigned area code does not count as a match",
      "line": "call 555-123-4567 now",
      "opts": { "to": "e164", "country": "1" },
      "expected": 0
    },
    {
      "description": "unknown calling code still counts as a match",
      "line": "+999 123 4567",
      "opts": { "to": "e164", "country": "1" },
      "expected": 1
    }
  ],
  "stripLine": [
    {
      "description": "two NANP numbers in one line are both removed",
      "line": "call me at 212.555.4567 or (800) 456-7890",
      "opts": { "to": "e164", "country": "1" },
      "expected": "call me at  or "
    },
    {
      "description": "an unassigned area code is not removed",
      "line": "call 555-123-4567 now",
      "opts": { "to": "e164", "country": "1" },
      "expected": "call 555-123-4567 now"
    },
    {
      "description": "a long digit run that isn't a phone number is left untouched",
      "line": "order id 1234567890123456 shipped",
      "opts": { "to": "e164", "country": "1" },
      "expected": "order id 1234567890123456 shipped"
    },
    {
      "description": "line with no digits is left untouched",
      "line": "no numbers here",
      "opts": { "to": "e164", "country": "1" },
      "expected": "no numbers here"
    },
    {
      "description": "an unresolvable calling code still counts as a match and is removed",
      "line": "call +999 123 4567 now",
      "opts": { "to": "e164", "country": "1" },
      "expected": "call  now"
    }
  ],
  "isWrappedAcrossLines": [
    {
      "description": "a number split by a wrap is detected and joins into a valid number",
      "prevLine": "call 212-555",
      "nextLine": "4567 today",
      "opts": { "to": "e164", "country": "1" },
      "expected": true
    },
    {
      "description": "a line ending with an already-complete number is not merged",
      "prevLine": "call 212-555-4567",
      "nextLine": "4567 more",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    },
    {
      "description": "a line that doesn't end in a digit is not merged",
      "prevLine": "no wrap here.",
      "nextLine": "4567 today",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    },
    {
      "description": "a dangling fragment that still fails to resolve after joining is not merged",
      "prevLine": "id 123-456",
      "nextLine": "89 done",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    }
  ],
  "mayContinueWrap": [
    {
      "description": "an incomplete tail followed by a line of pure digits keeps waiting",
      "prevLine": "call 2125554",
      "nextLine": "5",
      "opts": { "to": "e164", "country": "1" },
      "expected": true
    },
    {
      "description": "a next line with other text isn't a pure continuation fragment",
      "prevLine": "call 2125554",
      "nextLine": "5 today",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    },
    {
      "description": "a tail that already resolves on its own is not extended further",
      "prevLine": "call 212-555-4567",
      "nextLine": "89",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    },
    {
      "description": "a line with no dangling digit tail has nothing to continue",
      "prevLine": "no wrap here.",
      "nextLine": "5",
      "opts": { "to": "e164", "country": "1" },
      "expected": false
    }
  ]
}
